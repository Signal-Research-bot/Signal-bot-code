    "obsidian",
    "graph",
    "ai"
  ],
  "author": "signal-research-bot",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.8.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
