{
  "name": "ai-graph-highlighter",
  "version": "1.0.0",
  "description": "Obsidian plugin: AI-driven highlighting of nodes and weighted edges in the Graph view",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
