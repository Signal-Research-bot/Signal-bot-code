# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Nothing in this file is a default that happens to work -- every value is
# host- or account-specific, which is exactly why none of it lives in the
# committed compose file.

# --- Signal ------------------------------------------------------------------

# Base64 group id of the ONE group to ingest. List groups after linking with:
#   docker compose exec signal-cli signal-cli --config /data listGroups
# Anything from any other group is discarded at the parser, but this is the
# filter that makes that true -- do not leave it blank.
SRB_GROUP_ID=

# --- Encryption --------------------------------------------------------------

# 64 hex chars (32 bytes) for the SQLCipher message cache. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Losing this loses the cache, which is recoverable (Signal re-delivers only
# what is still queued -- in practice, not much). Leaking it exposes every
# cached message in plaintext.
SRB_CACHE_KEY=

# The pseudonym HMAC key is deliberately NOT here. It lives in the OS
# credential store (Windows Credential Manager) via keyring, and is created on
# first use. Putting it in a file next to the cache would defeat the point:
# an attacker with both can re-identify every participant.
# Set SRB_PSEUDONYM_KEY only for CI, never on the host.

# --- Anthropic ---------------------------------------------------------------

ANTHROPIC_API_KEY=

# The gate. These two numbers, multiplied, are essentially the whole cost model
# -- tightening the cap by one task/day saves more than any model swap.
SRB_MAX_TASKS_PER_WINDOW=4
SRB_WORTH_THRESHOLD=0.6

# --- Knowledge base ----------------------------------------------------------

# Absolute path to the KB vault (its own git repo, its own Obsidian vault).
SRB_KB_DIR=

# Path to the operator's pre-existing research vault, if any. The writer refuses
# to touch anything under here. Leave blank if there isn't one.
SRB_FOREIGN_VAULT_DIR=

# --- Ops ---------------------------------------------------------------------

# Post a summary back into the Signal group after each run. Leave false until
# you have seen a --dry-run you are happy with: summaries are visible to
# everyone in the group and appear under your own name.
SRB_NOTIFY=false

SRB_LOG_LEVEL=INFO

# Newline-separated identifiers that must never reach either git repo, read by
# tools/scrub_check.py. Normally supplied by var/scrub_tokens.local instead;
# this variable exists for CI, where that file does not exist.
# SCRUB_TOKENS=
